# ——— Local (.env.local) ———
# Client Vite (catalogue / apimo) — injectées au build
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ——— Vercel (Settings → Environment Variables) ———
# Formulaire contact : route /api/contact (côté serveur, pas besoin du préfixe VITE_)
# Recommandé : clé service_role (secrète, jamais dans le code client)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Alternative si pas de service_role (nécessite policy RLS insert pour anon) :
# SUPABASE_ANON_KEY= même clé anon que ci-dessus

# Pour le catalogue en prod, garder aussi :
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
