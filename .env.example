# Copier vers .env.local pour le dev :
#   cp .env.example .env.local
#
# Vercel → Settings → Environment Variables (Production + Preview)
# puis redéployer — Vite injecte ces variables au build.
#
# Supabase → Project Settings → API

VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Tag Manager — container chargé uniquement après consentement analytics (jamais dans le HTML pré-rendu).
# GA4 est configuré dans GTM ; sans VITE_GTM_ID, aucun tracking n'est chargé.
VITE_GTM_ID=GTM-XXXXXXX

# Flux GA4 (configuré dans GTM) : sert seulement au drapeau ga-disable et à la purge des cookies _ga_<ID>.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
