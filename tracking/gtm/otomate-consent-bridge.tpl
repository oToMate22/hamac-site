___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// OTOMATE – Consent Bridge (spécification v1.4.2, D2 option A).
// GTM n'est chargé par le site qu'après le consentement analytics :
// l'état par défaut reflète donc directement le choix enregistré par la CMP.
// Fermeture par défaut : si window.otomateConsent est absent ou invalide, tout est refusé.
// Publicité : toujours refusée en v1.

const setDefaultConsentState = require('setDefaultConsentState');
const updateConsentState = require('updateConsentState');
const callInWindow = require('callInWindow');

const toAnalytics = (state) => {
  if (state && state.analytics_storage === 'granted') return 'granted';
  return 'denied';
};

const current = callInWindow('otomateConsent.get');

setDefaultConsentState({
  ad_storage: 'denied',
  ad_user_data: 'denied',
  ad_personalization: 'denied',
  analytics_storage: toAnalytics(current)
});

// Révocation (et nouvelle acceptation sans rechargement) : la CMP appelle ce rappel.
callInWindow('otomateConsent.subscribe', (next) => {
  updateConsentState({
    analytics_storage: toAnalytics(next)
  });
});

data.gtmOnSuccess();


