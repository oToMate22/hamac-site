{
  "proxy": {
    "entrypoint": "src/proxy.ts",
    "matcher": [
      "/fr/propriete/:slug*",
      "/en/property/:slug*",
      "/es/propiedad/:slug*",
      "/es/:page"
    ]
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/fr/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/fr/",
      "permanent": true
    },
    {
      "source": "/en/",
      "destination": "/fr/",
      "permanent": true
    },
    {
      "source": "/en/agency",
      "destination": "/fr/agence",
      "permanent": true
    },
    {
      "source": "/en/buy",
      "destination": "/fr/acheter",
      "permanent": true
    },
    {
      "source": "/en/contact-us",
      "destination": "/fr/contact",
      "permanent": true
    },
    {
      "source": "/en/estimate",
      "destination": "/fr/estimation",
      "permanent": true
    },
    {
      "source": "/en/legal-notice",
      "destination": "/fr/mentions-legales",
      "permanent": true
    },
    {
      "source": "/en/legals/fees",
      "destination": "/fr/honoraires",
      "permanent": true
    },
    {
      "source": "/en/news/9567",
      "destination": "/fr/blog",
      "permanent": true
    },
    {
      "source": "/en/news/9568",
      "destination": "/fr/blog",
      "permanent": true
    },
    {
      "source": "/en/news/9569",
      "destination": "/fr/blog",
      "permanent": true
    },
    {
      "source": "/en/not-found",
      "destination": "/fr/",
      "permanent": true
    },
    {
      "source": "/en/rental-investments",
