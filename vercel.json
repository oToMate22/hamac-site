  "rewrites": [
    {
      "source": "/fr/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/fr/images/:path*",
      "destination": "/images/:path*"
    },
    {
      "source": "/fr/video/:path*",
      "destination": "/video/:path*"
    },
    {
      "source": "/fr/icons.svg",
      "destination": "/icons.svg"
    },
    {
      "source": "/fr/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/fr/favicon.svg",
      "destination": "/favicon.svg"
    },
    {
      "source": "/fr/favicon-32x32.png",
      "destination": "/favicon-32x32.png"
    },
    {
      "source": "/fr/apple-touch-icon.png",
      "destination": "/apple-touch-icon.png"
    },
    {
      "source": "/fr/acheter/:id",
